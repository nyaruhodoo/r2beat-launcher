{
  "name": "r2beat-launcher",
  "version": "2.3.9",
  "description": "音速觉醒启动器",
  "homepage": "https://electron-vite.org",
  "author": "https://github.com/nyaruhodoo",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "oxfmt",
    "lint": "eslint --fix --cache . && npm run typecheck",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "chcp 65001 && electron-vite dev",
    "build": "npm run format && npm run lint && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/typed-ipc": "^1.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "axios": "^1.13.6",
    "element-plus": "^2.13.6",
    "frida": "^17.6.0",
    "ini": "^6.0.0",
    "lzma-native": "^8.0.6",
    "pinyin-pro": "^3.28.0",
    "ps-list": "^9.0.0",
    "tsv": "^0.2.0",
    "vue": "^3.5.25",
    "vue-hooks-plus": "^2.4.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/ini": "^4.1.1",
    "@types/jsdom": "^27.0.0",
    "@types/lzma-native": "^4.0.4",
    "@types/node": "^22.19.1",
    "@types/tsv": "^0.2.4",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "oxfmt": "^0.41.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.2.6",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "frida",
      "lzma-native"
    ]
  }
}
